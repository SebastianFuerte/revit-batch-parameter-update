<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BatchParameterUpdate</RootNamespace>
    <AssemblyName>BatchParameterUpdate</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2026.4.10" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2026.4.10" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\BatchParameterUpdate.addin">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  
  <Target Name="DeployAddin" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <RevitAddinsDir>$(AppData)\Autodesk\Revit\Addins\2026</RevitAddinsDir>
    </PropertyGroup>
    <Copy SourceFiles="$(ProjectDir)Resources\BatchParameterUpdate.addin" DestinationFolder="$(RevitAddinsDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(RevitAddinsDir)\BatchParameterUpdate" />
  </Target>
</Project>