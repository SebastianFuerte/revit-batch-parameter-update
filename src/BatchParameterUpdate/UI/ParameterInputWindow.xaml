<Window x:Class="BatchParameterUpdate.UI.ParameterInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batch Parameter Update"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <StackPanel Margin="16">

        <TextBlock Text="Parameter name" Margin="0,0,0,4" />
        <TextBox x:Name="ParameterNameTextBox" Padding="4" Margin="0,0,0,12" />

        <TextBlock Text="New value" Margin="0,0,0,4" />
        <TextBox x:Name="ParameterValueTextBox" Padding="4" Margin="0,0,0,8" />

        <TextBlock x:Name="ValidationTextBlock"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Margin="0,0,0,8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Update"
                    Width="88"
                    Padding="4"
                    IsDefault="True"
                    Margin="0,0,8,0"
                    Click="OnUpdateClick" />
            <Button Content="Cancel"
                    Width="88"
                    Padding="4"
                    IsCancel="True" />
        </StackPanel>

    </StackPanel>
</Window>